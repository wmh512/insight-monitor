# 服务端配置模板
# 使用方法：复制本文件为 .env，把下面的占位内容换成真实值
# 注意：.env 已被 .gitignore 忽略（密码不进仓库），这个 .env.example 才会进仓库

# 服务监听端口
PORT=3000

# 上报鉴权令牌（W9-a）：SDK init 的 token 必须和这个一致；为空时拒绝所有上报
REPORT_TOKEN=dev-token

# 管理端账号密码（只放服务端 .env，不写进 admin 源码或 SDK）
# 两者都必须填写；生产使用独立强密码，不要复用上报 token 或数据库密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=在这里填管理端强密码

# 可选：面试官只读账号。未配置完整或已过期时自动禁用，不能修改数据。
# VIEWER_PROJECT_KEY 必须是数据库中演示项目的 project_key，不能使用真实项目。
# 示例到期时间：2026-12-31T15:59:59Z（北京时间 2026-12-31 23:59:59）
VIEWER_USERNAME=
VIEWER_PASSWORD=
VIEWER_PROJECT_KEY=
VIEWER_EXPIRES_AT=
# 单次请求体最大字节数（默认 64 KiB，避免无限读流）
MAX_BODY_BYTES=65536

# 单项目、单 IP 每分钟最大上报批次数（单进程限流）
REPORT_RATE_LIMIT=120

# 浏览器跨域白名单，逗号分隔；无 Origin 的服务端上报不受此限制
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 告警通知（W9-c）：Server酱 SendKey，新错误微信推送；为空则静默关闭
SCT_SENDKEY=

# MySQL 连接配置（对应你本机 W4-00 装好的环境）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在这里填你的MySQL密码
DB_NAME=insight_monitor
