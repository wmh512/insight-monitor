# 服务端配置模板
# 使用方法：复制本文件为 .env，把下面的占位内容换成真实值
# 注意：.env 已被 .gitignore 忽略（密码不进仓库），这个 .env.example 才会进仓库

# 服务监听端口
PORT=3000

# 上报鉴权令牌（W9-a）：SDK init 的 token 必须和这个一致；为空时拒绝所有上报
REPORT_TOKEN=dev-token

# 单次请求体最大字节数（默认 64 KiB，避免无限读流）
MAX_BODY_BYTES=65536

# 单项目、单 IP 每分钟最大上报批次数（单进程限流）
REPORT_RATE_LIMIT=120

# 浏览器跨域白名单，逗号分隔；无 Origin 的服务端上报不受此限制
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 告警通知（W9-c）：Server酱 SendKey，新错误微信推送；为空则静默关闭
SCT_SENDKEY=

# MySQL 连接配置（对应你本机 W4-00 装好的环境）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在这里填你的MySQL密码
DB_NAME=insight_monitor
